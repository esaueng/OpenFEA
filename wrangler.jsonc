{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Production local-first Worker (fea.esau.app): static assets plus
  // consent-gated, client-encrypted recovery backups only.
  // The OpenCAE Core Cloud container, Durable Object, and R2 artifact bindings
  // were retired in July 2026 — see docs/cloud-retirement.md. This config was
  // reconciled from the former wrangler.local-first.jsonc variant; solves run
  // in the browser, so the production Worker needs no solver bindings.
  // Existing OpenFEA production Worker, verified in the Cloudflare dashboard.
  "name": "openfea",
  "account_id": "747b74cbd7d019dd7aeecb2c24a4bf10",
  "main": "apps/openfea-web/worker/index.ts",
  "compatibility_date": "2026-04-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "fea.esau.app",
      "custom_domain": true
    }
  ],
  // PROJECT_BACKUP_DAILY_CAP_BYTES: encrypted-backup bytes accepted per UTC day
  // across all clients (positive integer byte count; 10737418240 = 10 GiB).
  "vars": {"GLIMPSE_BASIC_ENABLED":"true", "GLIMPSE_USAGE_ENABLED":"true", "PROJECT_BACKUP_DAILY_CAP_BYTES":"10737418240"},
  // PR previews run the browser workspace without production data or counters.
  // Assets and compatibility settings remain top-level per Wrangler's Preview API.
  "previews": {
    "vars": { "GLIMPSE_BASIC_ENABLED": "false", "GLIMPSE_USAGE_ENABLED": "false" },
    "services": [],
    "r2_buckets": [],
    "ratelimits": [],
    "durable_objects": { "bindings": [] }
  },
  "services": [{"binding":"GLIMPSE", "service":"glimpse", "entrypoint":"OpenFEAIngest"}],
  "assets": {
    "directory": "apps/openfea-web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health", "/healthz"]
  },
  "r2_buckets": [
    {
      "binding": "PROJECT_BACKUPS",
      "bucket_name": "opencae-project-backups"
    }
  ],
  "ratelimits": [
    {"name":"GLIMPSE_USAGE_LIMITER", "namespace_id":"2026101502", "simple":{"limit":120,"period":60}},
    {
      "name": "PROJECT_BACKUP_RATE_LIMITER",
      "namespace_id": "20260712",
      "simple": { "limit": 2, "period": 60 }
    }
  ],
  // Strongly consistent global ledger for the daily encrypted-backup byte cap.
  "durable_objects": {
    "bindings": [
      { "name": "PROJECT_BACKUP_DAILY_QUOTA", "class_name": "ProjectBackupDailyQuota" }
    ]
  },
  // Proactively enforce backup retention even when an uploaded object is never
  // requested again. The Worker also retains its lazy expiry check on reads.
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  // Full Durable Object migration history of the production Worker. Append new
  // tags only; never rewrite, reorder, or drop an applied tag. v3/v4 record the
  // retired container class (docs/cloud-retirement.md); v5 adds the daily
  // backup quota ledger. Wrangler sends only the tags after the Worker's
  // recorded tag, so each migration is pending once and must be applied by
  // `wrangler deploy`; `wrangler versions upload` refuses pending migrations.
  "migrations": [
    { "tag": "v3-opencae-core-cloud-container", "new_sqlite_classes": ["OpenCaeCoreCloudContainer"] },
    { "tag": "v4-retire-opencae-core-cloud-container", "deleted_classes": ["OpenCaeCoreCloudContainer"] },
    { "tag": "v5-project-backup-daily-quota", "new_sqlite_classes": ["ProjectBackupDailyQuota"] }
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
